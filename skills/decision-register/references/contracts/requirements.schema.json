{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximsamokhval/codex-personal-skills/contracts/requirements-pipeline/v1/requirements.schema.json",
  "title": "Requirements pipeline requirements artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "sources", "requirements", "open_items"],
  "properties": {
    "schema_version": {"const": "requirements/v1"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "language"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "locator_scheme": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "open_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/openItem"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statement", "provenance", "source_refs", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^(BG|BR|FR|NFR|CON)-[0-9]{3,}$"},
        "type": {
          "enum": ["business-goal", "business-rule", "functional", "non-functional", "constraint"]
        },
        "statement": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["explicit", "derived"]},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "attributes": {"type": "object"},
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["support_refs", "explanation"],
          "properties": {
            "support_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "explanation": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"provenance": {"const": "derived"}}},
          "then": {"required": ["derivation"]}
        }
      ]
    },
    "openItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "reason", "affected_ids", "severity", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^OPEN-[0-9]{3,}$"},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "affected_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(BG|BR|FR|NFR|CON)-[0-9]{3,}$"}
        },
        "severity": {"enum": ["blocker", "risk", "note"]},
        "status": {"enum": ["open", "resolved", "accepted-risk"]}
      }
    }
  }
}
