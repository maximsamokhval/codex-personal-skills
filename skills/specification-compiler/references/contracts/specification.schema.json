{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximsamokhval/codex-personal-skills/contracts/requirements-pipeline/v1/specification.schema.json",
  "title": "Requirements pipeline compiled specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements_sha256",
    "baseline_sha256",
    "invariants",
    "acceptance_criteria",
    "failure_scenarios",
    "gaps",
    "traceability"
  ],
  "properties": {
    "schema_version": {"const": "requirements-specification/v1"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/acceptanceCriterion"}},
    "failure_scenarios": {"type": "array", "items": {"$ref": "#/$defs/failureScenario"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "traceability": {"type": "array", "items": {"$ref": "#/$defs/traceability"}}
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(BG|BR|FR|NFR|CON)-[0-9]{3,}$"}
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "scope", "checkable_condition", "violation_condition", "source_requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^INV-[0-9]{3,}$"},
        "statement": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "checkable_condition": {"type": "string", "minLength": 1},
        "violation_condition": {"type": "string", "minLength": 1},
        "source_requirement_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
        "statement": {"type": "string", "minLength": 1},
        "source_requirement_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "failureScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario", "expected_behavior", "source_requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^FAIL-[0-9]{3,}$"},
        "scenario": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "source_requirement_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "source_requirement_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^GAP-[0-9]{3,}$"},
        "description": {"type": "string", "minLength": 1},
        "source_requirement_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "invariants", "acceptance_criteria", "failure_scenarios", "gaps"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^(BG|BR|FR|NFR|CON)-[0-9]{3,}$"},
        "invariants": {"type": "array", "items": {"type": "string", "pattern": "^INV-[0-9]{3,}$"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]{3,}$"}},
        "failure_scenarios": {"type": "array", "items": {"type": "string", "pattern": "^FAIL-[0-9]{3,}$"}},
        "gaps": {"type": "array", "items": {"type": "string", "pattern": "^GAP-[0-9]{3,}$"}}
      }
    }
  }
}
